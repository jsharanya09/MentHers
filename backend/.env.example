PORT=3001
APP_URL=http://localhost:5173

# Email. Used for verification codes and intro-request notices.
# Leave SMTP_HOST empty in development: emails (and codes) are printed in the terminal instead.
# You must set it before real users can sign up, since they need the code from their inbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MentHers <no-reply@example.com>
