# Copy this file to backend/.env and fill in what you need. Never commit backend/.env.
PORT=3001

# The address people use to open the app (used for links in emails).
# Locally the frontend runs on 5173 (or whatever port Vite prints).
APP_URL=http://localhost:5173

# ---- Email (verification codes, request notices) ----
# Leave SMTP_HOST empty in development: emails and codes are printed in the terminal instead.
# You MUST set these before real users can sign up, since they need the code from their inbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MentHers <no-reply@example.com>

# ---- AI features (optional) ----
# An Anthropic API key turns on AI match explanations and AI-drafted intro messages.
ANTHROPIC_API_KEY=

# ---- Safety reports (optional) ----
# Where "Report a problem" submissions are emailed. They are always saved in the database.
ADMIN_EMAIL=

# ---- Database (optional) ----
# DB_PATH=./storage/menthers.db
# Set to false to stop adding the demo mentors:
# SEED_SAMPLE_MENTORS=true
